# ==========================================
# UFA Flood Alert - Environment Configuration
# ==========================================

# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=ufa-deploy.onrender.com,localhost,127.0.0.1

# Admin Panel Password
ADMIN_PASSWORD=your-admin-password

# LINE Messaging API Credentials
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# Production Database (TiDB / MySQL on Render)
RENDER=true
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your-tidb-user
TIDB_PASSWORD=your-tidb-password
TIDB_DATABASE=ubon_flood_alert

# Local Database (Development)
LOCAL_DB_NAME=ubon_flood_alert
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=Apirat2018
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306

# Scheduler (Set to false if running via GitHub Actions exclusively)
ENABLE_SCHEDULER=true

